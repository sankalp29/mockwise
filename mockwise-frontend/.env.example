# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env
#
# LOCAL: use the Mockwise-Local Supabase project (not production).
# PROD build: set hosting env vars to the production Supabase project.

# Supabase Auth (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API base URL, no trailing slash
VITE_API_BASE_URL=http://localhost:8080

# Local testing — defaults ON in non-production. Forced OFF in production builds.
# Set false to restore Supabase login.
VITE_BYPASS_AUTH=true
